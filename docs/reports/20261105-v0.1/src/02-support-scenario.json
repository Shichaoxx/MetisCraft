              "text": "CC-BY-4.0",
              "muted": true
            }
          ]
        },
        {
          "id": "intent",
          "role": "io",
          "col": 1,
          "title": "原始意图",
          "lines": [
            "77 个标签"
          ]
        }
      ]
    },
    {
      "label": "映射表",
